{
  "schema_version": "0.1",
  "locked_at": "2026-07-28",
  "rust": {
    "version": "1.97.1",
    "source": "https://blog.rust-lang.org/2026/07/16/Rust-1.97.1/",
    "commands": [
      "cargo fmt --check",
      "cargo clippy --all-targets --all-features -- -D warnings",
      "cargo test --all-features --locked"
    ]
  },
  "cargo-audit": {
    "version": "0.22.2",
    "source": "https://docs.rs/crate/cargo-audit/0.22.2",
    "command": "cargo audit"
  },
  "cargo-deny": {
    "version": "0.20.2",
    "source": "https://docs.rs/crate/cargo-deny/0.20.2",
    "command": "cargo deny --locked --all-features check advisories bans licenses sources"
  },
  "nix": {
    "minimum": "2.28",
    "command": "nix flake check .. --no-update-lock-file --no-write-lock-file"
  }
}
